# OpenAI — enables real AI parsing in the Benefit Parser tab
# Without this, the app uses a built-in demo response
OPENAI_API_KEY=your_openai_api_key_here

# Supabase — enables email magic link auth
# Without these, the app runs in demo mode (no login required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
